# Copy to .env.local. Every value is public (it ends up in the static bundle).
VITE_NETWORK=kairos
VITE_API_URL=https://app-api.cojam.app
VITE_PRIVY_APP_ID=cmwxqqrt0017p0gl5hi2gewh7
VITE_SWAP_URL=https://cojam.app/migrate/
VITE_RELEASE=dev
# Release id and environment for Sentry (not wired yet): RELEASE in src/config.ts
# 1: run every screen on the in app mock adapter (no server), with the design's ?state= presets
VITE_API_MOCK=0
# 1: replace Privy with a local throwaway wallet (tests, offline development). On by default when VITE_API_MOCK=1
VITE_WALLET_MOCK=0
VITE_SENTRY_DSN=
# Local only (ignored by production builds): talk to a local API with AUTH_DEV_BYPASS=1 as this dev user (X-Dev-User),
# signing with the API's dev wallet key for the name. See .env.devapi and e2e/live.cjs.
VITE_DEV_USER=
