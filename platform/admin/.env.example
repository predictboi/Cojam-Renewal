# Cojam admin (admin.cojam.app). Every value here is public (it ends up in the browser bundle).
# The admin API, same service as the player API.
VITE_API_URL=http://localhost:8080
# The SEPARATE admin Privy app (email login only). Never the player app id.
VITE_PRIVY_ADMIN_APP_ID=
# Local only: sign in as this allow listed email with the X-Dev-Admin header (needs AUTH_DEV_BYPASS=1 on the API).
# Ignored by production builds (vite build): the code path is removed.
VITE_DEV_ADMIN=
# 1 = every screen runs on the design's mock data (platform/design/admin/data.js), ?state= presets work.
VITE_API_MOCK=
