# cojam-app-api and cojam-app-worker. Copy to .env for local work. Never commit real secrets.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
NETWORK=kairos
CHAIN_ID=1001
KAIA_RPC_URL=https://public-en-kairos.node.kaia.io
KAIA_RPC_URL_FALLBACK=
DATABASE_URL=postgres://cojam:cojam@localhost:5432/cojam_dev
CT_ADDRESS=
PREDICT_ADDRESS=
PREDICT_DEPLOY_BLOCK=0
STAKING_ADDRESS=
STAKING_DEPLOY_BLOCK=0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://app.cojam.app,https://admin.cojam.app
APP_URL=https://app.cojam.app
MIN_APP_VERSION=0.0.0
TRUST_PROXY=0

# Privy (the App Secret only in Render, never in the repo)
PRIVY_APP_ID=cmwxqqrt0017p0gl5hi2gewh7
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
PRIVY_ADMIN_APP_ID=
PRIVY_ADMIN_APP_SECRET=
PRIVY_ADMIN_VERIFICATION_KEY=
ADMIN_OWNER_EMAIL=

# Dev only: trust the X-Dev-User header (and X-Dev-Admin for /admin). Impossible with NODE_ENV=production.
AUTH_DEV_BYPASS=1

# Sign up and abuse
EMAIL_HASH_KEY=dev-only-email-hash-key
IP_HASH_SALT=dev-only-ip-salt
PLAY_KEY_TTL_DAYS=30
SIGNUP_IP_PER_DAY=20
SIGNUP_IP_FLAG_PER_DAY=5
SIGNUP_DEVICE_PER_DAY=2
SIGNUP_DEVICE_TOTAL=3
SIGNUP_GLOBAL_PER_HOUR_MIN=200
EMAIL_CHECK_IP_PER_HOUR=10
EMAIL_CHECK_DEVICE_PER_HOUR=5
EMAIL_CHECK_EMAIL_PER_HOUR=5
INVITE_LOOKUP_IP_PER_HOUR=30
INVITE_REDEEM_PER_HOUR=10
INVITE_LINKS_PER_INVITER_PER_DAY=30
RISK_BLOCK_SCORE=80
RISK_REVIEW_SCORE=50
SUPPORT_EMAIL=help@cojam.app

# Sponsorship (api only)
APP_FEE_PAYER_PRIVATE_KEY=
MAX_GAS_PRICE_GKEI=50
SPONSOR_PREDICT_PER_DAY=10
SPONSOR_SETPLAYKEY_PER_DAY=3
SPONSOR_OTHER_PER_DAY=15
SPONSOR_IP_PER_DAY=300
SPONSOR_BURST_PER_MIN=20
SPONSOR_SIMULATE=1
DAILY_BUDGET_KAIA=10
MIN_FEE_PAYER_BALANCE_KAIA=10
MIN_OPERATOR_BALANCE_KAIA=5
KRW_PER_CT=0

# Worker only
OPERATOR_PRIVATE_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MONTHLY_BUDGET_USD=300
IMAGE_API_KEY=
IMAGE_MODEL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
IMAGE_BASE_URL=https://img.cojam.app
# Worker settings (WORKER.md section 3)
AI_ENABLED=1
DRAFT_HORIZON_DAYS=7
DRAFT_CANDIDATES=12
SETTLE_BATCH=100
REGISTER_BATCH=100
COMPENSATE_BATCH=300
WEEKLY_POOL_PER_PLAYER_CT=1
WEEKLY_POOL_CAP_CT=10000
OPERATOR_TX_TYPE=legacy
INDEXER_RANGE=2000
INDEXER_CONFIRMATIONS=0
# Address only (balance monitor): the API's fee payer
APP_FEE_PAYER_ADDRESS=
# Dev only, refused in production: AI_PROVIDER=fake (deterministic AI), WORKER_CLOCK=chain (follow a local node's clock)

# Monitoring
SENTRY_DSN=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL=
ADMIN_SERVICE_TOKEN_SHA256=
ADMIN_SERVICE_PER_MINUTE=120
